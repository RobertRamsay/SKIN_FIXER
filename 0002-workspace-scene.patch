+                if (nextVisible != groundVisible)
+                {
+                    Undo.RecordObject(workspace.groundPlane, "Toggle Ground");
+                    workspace.SetGroundVisible(nextVisible);
+                }
+            }
+
+            EditorGUILayout.EndHorizontal();
+        }
